# Copy this file to `.env` and fill in the values for your project.
# `.env` is gitignored; on Vercel set the same variables in
# Project → Settings → Environment Variables.

# Supabase project (publishable/browser-safe values only).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Optional canonical app URL used in auth redirects. Defaults to
# https://app.tradezanga.com so auth emails never point at localhost.
# VITE_APP_URL="https://app.tradezanga.com"

# Optional Tawk.to embed URL override (defaults to the legacy TradeZanga
# property). Set to "off" to disable the chat widget.
# VITE_TAWK_EMBED_URL="https://embed.tawk.to/683623d24a34301911ec75e0/1is9nnrs7"

# Server-side / CLI only — never prefix these with VITE_.
SUPABASE_PROJECT_REF="your-project-ref"

# Scoped personal access token for `npm run emails:push`.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""

# Legacy demo accounts (development only).
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""
